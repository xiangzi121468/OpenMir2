<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\net8.0\WebApi.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="6.5.0" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.5.0" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.5.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
      <PackageReference Include="MySqlConnector" Version="2.3.1" />
      <PackageReference Include="NLog" Version="5.2.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Modules\ShopModule\ShopModule.csproj" />
      <ProjectReference Include="..\Modules\ActivityModule\ActivityModule.csproj" />
      <ProjectReference Include="..\Modules\NoticeModule\NoticeModule.csproj" />
      <ProjectReference Include="..\Modules\VipModule\VipModule.csproj" />
      <ProjectReference Include="..\Modules\AppraisalModule\AppraisalModule.csproj" />
    </ItemGroup>

</Project>
